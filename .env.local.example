# Canonical site URL — used for SEO (canonical tag, sitemap, robots, OG/JSON-LD).
# Set this to your real Vercel/custom domain after deploying. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://kapil-badgujjar.vercel.app

# Used by the Hero "Download Resume" button.
# Default falls back to /resume.pdf shipped in /public.
NEXT_PUBLIC_RESUME_URL=/resume.pdf

# Used by the Contact form action (Formspree, Web3Forms, or similar).
# Leave blank to render the form in a no-op mode that opens a mailto: link instead.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
